# Generates a C source embedding the bundled TTF fonts so the desktop app looks
# identical on every platform without shipping loose font files.
#   cmake -DOUT=<file.c> -DFONT_DIR=<dir> -P embed_fonts.cmake
set(FONTS
    Inter-Regular.ttf inter_regular
    Inter-Medium.ttf inter_medium
    Inter-SemiBold.ttf inter_semibold
    SourceSerif4Display-Regular.ttf serif_display
    SourceSerif4Subhead-Semibold.ttf serif_subhead)

set(content "/* Generated by cmake/embed_fonts.cmake - do not edit. */\n#include <stddef.h>\n\n")
list(LENGTH FONTS n)
math(EXPR last "${n} - 1")
foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET FONTS ${i} file)
    list(GET FONTS ${j} name)
    file(READ "${FONT_DIR}/${file}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "const unsigned char lisper_font_${name}[] = {${bytes}};\n")
    string(APPEND content "const size_t lisper_font_${name}_size = ${size};\n\n")
endforeach()
file(WRITE "${OUT}" "${content}")
